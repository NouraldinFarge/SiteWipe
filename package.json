{
  "name": "sitewipe-private-release-candidate",
  "version": "1.11.4",
  "private": true,
  "license": "MIT",
  "description": "Private release candidate for guarded, target-scoped browser-data cleanup.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "version:bump": "node scripts/bump-version.mjs",
    "check:version": "node scripts/check-version.mjs",
    "test": "npm run test:legacy && npm run test:unit",
    "test:legacy": "node src/test-harness/release-selftest.mjs",
    "test:unit": "node scripts/run-tests.mjs",
    "test:property": "node --test tests/property/*.test.mjs",
    "test:coverage": "c8 --all --src src/background --src src/shared --reporter=text --reporter=lcov --check-coverage --lines 80 --statements 80 --branches 55 --functions 70 node scripts/run-tests.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:types": "tsc -p jsconfig.json",
    "check:lint": "eslint .",
    "check:format": "prettier --check .",
    "check:html": "html-validate src/**/*.html",
    "check:css": "stylelint \"src/**/*.css\"",
    "check:manifest": "node scripts/validate-manifest.mjs",
    "check:remote-code": "node scripts/check-remote-code.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:dependency-licenses": "node scripts/check-dependency-licenses.mjs",
    "check:project-license": "node scripts/check-project-license.mjs",
    "check:notices": "node scripts/check-notices.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:action-pins": "node scripts/check-action-pins.mjs",
    "check:package-allowlist": "node scripts/validate-package-allowlist.mjs",
    "check:publication-gates": "node scripts/check-publication-gates.mjs",
    "check": "npm run check:format && npm run check:version && npm run check:syntax && npm run check:types && npm run check:lint && npm run check:html && npm run check:css && npm run check:manifest && npm run check:remote-code && npm run check:secrets && npm run check:dependency-licenses && npm run check:project-license && npm run check:notices && npm run check:assets && npm run check:docs && npm run check:action-pins && npm run check:package-allowlist && npm test && npm run test:property",
    "browser:fixture": "node tests/browser/fixture-server.mjs",
    "build:release-candidate": "node scripts/build-release.mjs",
    "verify:release-candidate": "node scripts/verify-release.mjs",
    "sbom": "cyclonedx-npm --output-format JSON --output-file dist/sitewipe-development-sbom.cdx.json",
    "psl:update": "node scripts/update-public-suffix-data.mjs"
  },
  "files": [
    "src/",
    "tests/",
    "scripts/",
    "docs/",
    "third_party/",
    ".github/",
    "README.md",
    "PRIVACY.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "SUPPORT.md",
    "CODE_OF_CONDUCT.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "6.0.1",
    "@eslint/js": "10.0.1",
    "@types/chrome": "0.2.6",
    "@types/node": "26.2.0",
    "axe-core": "4.13.0",
    "c8": "12.0.0",
    "eslint": "10.8.1",
    "fast-check": "4.9.0",
    "globals": "17.11.0",
    "html-validate": "11.7.0",
    "prettier": "3.9.6",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "typescript": "7.0.2",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  }
}
